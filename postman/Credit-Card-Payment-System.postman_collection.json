    "item":  [
                 {
                     "name":  "01 Authentication",
                     "item":  [
                                  {
                                      "name":  "Register",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"first_name\": \"{{first_name}}\",\n  \"last_name\": \"{{last_name}}\",\n  \"password\": \"{{password}}\",\n  \"password_confirm\": \"{{password}}\"\n}"
                                                               },
                                                      "url":  "{{django_base}}/auth/register/"
                                                  }
                                  },
                                  {
                                      "name":  "Login",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Login succeeded\u0027, function () {",
                                                                                    "    pm.response.to.have.status(200);",
                                                                                    "});",
                                                                                    "const data = pm.response.json();",
                                                                                    "if (data.access) pm.collectionVariables.set(\u0027access_token\u0027, data.access);",
                                                                                    "if (data.refresh) pm.collectionVariables.set(\u0027refresh_token\u0027, data.refresh);"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
                                                               },
                                                      "url":  "{{django_base}}/auth/login/"
                                                  }
                                  },
                                  {
                                      "name":  "Refresh Token",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Refresh succeeded\u0027, function () {",
                                                                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                                                                                    "});",
                                                                                    "const data = pm.response.json();",
                                                                                    "if (data.access) pm.collectionVariables.set(\u0027access_token\u0027, data.access);"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
                                                               },
                                                      "url":  "{{django_base}}/auth/refresh/"
                                                  }
                                  },
                                  {
                                      "name":  "Logout",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     },
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{access_token}}"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
                                                               },
                                                      "url":  "{{django_base}}/auth/logout/"
                                                  }
                                  }
                              ]
                 },
                 {
                     "name":  "02 Cards",
                     "item":  [
                                  {
                                      "name":  "Get Saved Cards",
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{access_token}}"
                                                                     }
                                                                 ],
                                                      "url":  "{{django_base}}/cards/"
                                                  }
                                  },
                                  {
                                      "name":  "Add Credit Card",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Card created\u0027, function () { pm.response.to.have.status(201); });",
                                                                                    "const data = pm.response.json();",
                                                                                    "if (data.id) pm.collectionVariables.set(\u0027card_id\u0027, data.id);",
                                                                                    "pm.test(\u0027CVV is not returned\u0027, function () { pm.expect(JSON.stringify(data).toLowerCase()).to.not.contain(\u0027cvv\u0027); });",
                                                                                    "pm.test(\u0027Full card number is not returned\u0027, function () { pm.expect(JSON.stringify(data)).to.not.contain(\u00274111111111111111\u0027); });"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     },
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{access_token}}"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"card_type\": \"CREDIT\",\n  \"card_number\": \"4111111111111111\",\n  \"cvv\": \"123\",\n  \"expiry_month\": 12,\n  \"expiry_year\": 2030\n}"
                                                               },
                                                      "url":  "{{django_base}}/cards/"
                                                  }
                                  },
                                  {
                                      "name":  "Delete Card",
                                      "request":  {
                                                      "method":  "DELETE",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{access_token}}"
                                                                     }
                                                                 ],
                                                      "url":  "{{django_base}}/cards/{{card_id}}/"
                                                  }
                                  }
                              ]
                 },
                 {
                     "name":  "03 Payments (FastAPI)",
                     "item":  [
                                  {
                                      "name":  "Health Check",
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{fastapi_base}}/health"
                                                  }
                                  },
                                  {
                                      "name":  "Make Payment",
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Payment request succeeded\u0027, function () { pm.response.to.have.status(201); });",
                                                                                    "const data = pm.response.json();",
                                                                                    "pm.test(\u0027Final payment status is SUCCESS or FAILED\u0027, function () { pm.expect([\u0027SUCCESS\u0027, \u0027FAILED\u0027]).to.include(data.status); });"
                                                                                ]
                                                                   }
                                                    }
                                                ],
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     },
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{access_token}}"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"card_id\": \"{{card_id}}\",\n  \"amount\": 500,\n  \"currency\": \"INR\",\n  \"description\": \"Postman payment test\"\n}"
                                                               },
                                                      "url":  "{{fastapi_base}}/api/payments/"
                                                  }
                                  },
                                  {
                                      "name":  "Invalid Payment Amount",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     },
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{access_token}}"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"card_id\": \"{{card_id}}\",\n  \"amount\": 0,\n  \"currency\": \"INR\",\n  \"description\": \"Validation test\"\n}"
                                                               },
                                                      "url":  "{{fastapi_base}}/api/payments/"
                                                  }
                                  }
                              ]
                 },
