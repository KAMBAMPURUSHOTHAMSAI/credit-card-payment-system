                  "pm.test('Health response includes status and database_status', function () { pm.expect(data).to.have.property('status'); pm.expect(data).to.have.property('database_status'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 Fraud Detection (run in order)",
      "description": "Use the same normal user's access_token and a card owned by that user. Run Baseline Signal first, then Changed Location/Device within five minutes. The rule compares recent transactions for the same user. Existing recent transactions can also cause a flag, so inspect FraudLog/rule_code when verifying the specific trigger. Fraud flags alert and log; they do not automatically reject the payment in this implementation.",
      "item": [
        {
          "name": "Fraud Test A - Baseline Signal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "X-Client-Location",
                "value": "{{fraud_location_a}}"
              },
              {
                "key": "X-Device-ID",
                "value": "{{fraud_device_a}}"
              }
            ],
            "url": "{{fastapi_base}}/api/payments/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"amount\": \"100.00\",\n  \"currency\": \"INR\",\n  \"description\": \"Fraud test baseline signal A\",\n  \"category\": \"OTHER\"\n}"
            },
            "description": "Run first. Uses fraud_location_a and fraud_device_a. A recent earlier transaction might also trigger a fraud flag; verify the rule_code in FraudLog if needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Baseline payment endpoint returned 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('Payment response includes fraud_status', function () { pm.expect(data).to.have.property('fraud_status'); });",
                  "pm.test('Payment status is SUCCESS or FAILED', function () { pm.expect(['SUCCESS', 'FAILED']).to.include(data.status); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Fraud Test B - Changed Location and Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "X-Client-Location",
                "value": "{{fraud_location_b}}"
              },
              {
                "key": "X-Device-ID",
                "value": "{{fraud_device_b}}"
              }
            ],
            "url": "{{fastapi_base}}/api/payments/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_id\": \"{{card_id}}\",\n  \"amount\": \"100.00\",\n  \"currency\": \"INR\",\n  \"description\": \"Fraud test changed location and device B\",\n  \"category\": \"OTHER\"\n}"
            },
            "description": "Run within five minutes of the baseline, with the same user and card. The device/location rule should flag the changed signals. A payment can still be SUCCESS or FAILED independently of fraud_status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Changed-signal payment endpoint returned 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('Fraud status is FLAGGED after changed signals', function () { pm.expect(data.fraud_status).to.eql('FLAGGED'); });",
                  "pm.test('Payment status remains a separate outcome', function () { pm.expect(['SUCCESS', 'FAILED']).to.include(data.status); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
