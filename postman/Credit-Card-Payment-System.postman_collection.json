{
    "info":  {
                 "_postman_id":  "d3f3a4df-65f8-4aef-9f5d-credit-card-payment-system",
                 "name":  "Credit Card Payment System",
                 "description":  "Postman collection for the Credit Card Payment System. Django handles authentication, cards, transactions and admin APIs; FastAPI handles payment processing.",
                 "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
             },
    "variable":  [
                     {
