        {
          "name": "Dashboard Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard summary succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "",
                  "pm.test('total_transactions exists', function () {",
                  "    pm.expect(data).to.have.property('total_transactions');",
                  "});",
                  "",
                  "pm.test('total_amount_spent exists', function () {",
                  "    pm.expect(data).to.have.property('total_amount_spent');",
                  "});",
                  "",
                  "pm.test('current_month_spending exists', function () {",
                  "    pm.expect(data).to.have.property('current_month_spending');",
                  "});",
                  "",
                  "pm.test('available_credit_limit exists', function () {",
                  "    pm.expect(data).to.have.property('available_credit_limit');",
                  "});",
                  "",
                  "pm.test('last_5_transactions exists', function () {",
                  "    pm.expect(data).to.have.property('last_5_transactions');",
                  "});",
                  "",
                  "pm.test('Maximum 5 transactions returned', function () {",
                  "    pm.expect(data.last_5_transactions).to.be.an('array');",
                  "    pm.expect(data.last_5_transactions.length).to.be.at.most(5);",
                  "});",
                  "",
                  "pm.test('Recent transaction fields are present', function () {",
                  "    data.last_5_transactions.forEach(function (transaction) {",
                  "        pm.expect(transaction).to.have.property('amount');",
                  "        pm.expect(transaction).to.have.property('masked_card_number');",
                  "        pm.expect(transaction).to.have.property('date');",
                  "        pm.expect(transaction).to.have.property('status');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
