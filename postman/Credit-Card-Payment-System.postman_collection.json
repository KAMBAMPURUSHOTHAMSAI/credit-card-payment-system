                         "value":  "http://127.0.0.1:8000/api"
                     },
                     {
                         "key":  "fastapi_base",
                         "value":  "http://127.0.0.1:8001"
                     },
                     {
                         "key":  "username",
                         "value":  "replace-me"
                     },
                     {
                         "key":  "password",
                         "value":  "replace-me"
                     },
                     {
                         "key":  "email",
                         "value":  "replace-me@example.com"
                     },
                     {
                         "key":  "first_name",
                         "value":  "Test"
                     },
                     {
                         "key":  "last_name",
                         "value":  "User"
                     },
                     {
                         "key":  "access_token",
                         "value":  ""
                     },
                     {
                         "key":  "refresh_token",
                         "value":  ""
                     },
                     {
                         "key":  "card_id",
                         "value":  ""
